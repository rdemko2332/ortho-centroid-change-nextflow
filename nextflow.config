includeConfig "$baseDir/conf/processResources.conf"

profiles {
  recompute {
    params {
      outputDir = "$launchDir/recomputeOutput"

      // peripheralEntryResults (core + peripheral)
      coreGroupFastasDir  = "/home/rdemko/workspace/temp/peripheralEntryResults/groupFastas"
      coreBestReps        = "/home/rdemko/workspace/temp/peripheralEntryResults/coreBestReps.txt"
      intraGroupBlastFile = "/home/rdemko/workspace/temp/peripheralEntryResults/intraGroupBlastFile.tsv"
      coreStats           = "/home/rdemko/workspace/temp/peripheralEntryResults/groupStats/core_stats.txt"
      peripheralStats     = "/home/rdemko/workspace/temp/peripheralEntryResults/groupStats/peripheral_stats.txt"

      // postResidualEntryResults
      residualGroupFastasDir      = "/home/rdemko/workspace/temp/postResidualEntryResults/residualGroupFastas"
      residualBestReps            = "/home/rdemko/workspace/temp/postResidualEntryResults/residualBestReps.txt"
      intraResidualGroupBlastFile = "/home/rdemko/workspace/temp/postResidualEntryResults/intraResidualGroupBlastFile.tsv"
      residualStats                = "/home/rdemko/workspace/temp/postResidualEntryResults/groupStats/residual_stats.txt"

      // postProcessingEntryResults
      fullGroupFile     = "/home/rdemko/workspace/temp/postProcessingEntryResults/fullGroupFile.txt"
      bestRepsFullFasta = "/home/rdemko/workspace/temp/postProcessingEntryResults/bestRepsFull.fasta"
      fullProteome      = "/home/rdemko/workspace/temp/postProcessingEntryResults/fullProteome.fasta"

      // step 1 tunables
      exactCentroidLimit  = 2000
      centroidDiamondArgs = '--very-sensitive -e 1e-3'
      classifyBatchSize   = 5000   // cheap grep-count loop, no diamond -- large batches are fine
      exactBatchSize      = 200    // each group does 1 diamond makedb+blastp pair
      largeBatchSize      = 20     // only ~401 groups total; keep small so one huge group can't dominate a task

      // steps 2+3 tunables
      distanceBatchSize          = 2000
      distanceEvalue             = 1
      distanceThreshold          = "1e-15"
      distanceDiamondOutputFields = "qseqid sseqid evalue"

      // steps 4+5 tunables
      globalSearchEvalue  = 1
      exponentImprovement = 2
    }
    docker {
      enabled = true
      runOptions = '--user root'
    }
    singularity {
      enabled = false
    }
  }
}
